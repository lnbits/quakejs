textures/quakejs_logos/bitfest
{
    polygonOffset
    nopicmip
    sort decal
    surfaceparm nonsolid
    surfaceparm nomarks
    {
        clampmap textures/quakejs_logos/bitfest.tga
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        rgbGen identity
    }
}

